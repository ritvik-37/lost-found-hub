# Leave empty in development: Vite proxies /api and /uploads to the API (port from server/.env, default 5050).
# For a split deploy (e.g. client on Vercel, API on Render) set the API origin, no trailing slash:
# VITE_API_URL=https://your-api.onrender.com
VITE_API_URL=

# Campus name shown in the home page badge
VITE_CAMPUS_NAME=SRM Campus
