{
  "name": "lost-found-hub-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch-path=./src src/index.js",
    "start": "node src/index.js",
    "db": "node scripts/local-db.js",
