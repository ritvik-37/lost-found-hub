# Copy to server/.env and adjust. Every value has a safe local default.

# Port the API listens on (5050 avoids macOS AirPlay / other apps that grab 5000).
# The Vite dev proxy reads this value too, so change it in one place.
PORT=5050

# MongoDB connection string (Atlas or a local mongod).
# Leave EMPTY to use the embedded MongoDB started by `npm run dev` / `npm run db`
# (data persists in ~/.lost-found-hub/mongo-data and is auto-seeded on first run).
DB_URL=

# Long random string used to sign login tokens. REQUIRED in production.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend origin(s) allowed by CORS, comma-separated
CLIENT_URL=http://localhost:5173

# Optional: only allow sign-ups from this email domain, e.g. srmist.edu.in
ALLOWED_EMAIL_DOMAIN=

# Cookie SameSite policy. Use "none" when the client and API live on different sites
# (e.g. Vercel + Render); that also forces Secure cookies (HTTPS only).
COOKIE_SAMESITE=lax

# Set to 1 when running behind a reverse proxy / PaaS load balancer (Render, Railway, Nginx)
TRUST_PROXY=

# Load the demo data on startup if the database has no users yet (useful for a hosted demo).
# The embedded dev DB always does this. Never enable on a real deployment with real users' data.
SEED_ON_EMPTY=false

# One-click demo sign-in buttons for the seeded accounts (no passwords reach the browser).
# Default: on in development, off when NODE_ENV=production. Anyone who opens the site can then act as the demo admin.
DEMO_LOGINS=

# Passwords for the seeded accounts. Leave empty to get random ones, printed once by `npm run seed`.
# Never commit real values; keep them only in this untracked .env file.
DEMO_ADMIN_PASSWORD=
DEMO_STUDENT_PASSWORD=

# Embedded MongoDB settings (only used when DB_URL is empty)
LOCAL_DB_PORT=27027
# LOCAL_DB_PATH=C:/path/to/mongo-data
